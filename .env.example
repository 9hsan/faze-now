# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never import into client components
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud -> YouTube Data API v3
YOUTUBE_API_KEY=

# Google Gemini: AI creator briefs (server-side only; set it on Vercel too)
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash)
GEMINI_MODEL=
